        </mxCell>
        <mxCell id="land" value="Land &amp; clean&#10;Bronze -&gt; Silver&#10;quarantine, dedupe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#1D425C;" vertex="1" parent="1">
