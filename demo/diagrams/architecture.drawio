        </mxCell>
        <mxCell id="gold" value="Business-ready&#10;7 gold tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#1D425C;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="use" value="What you use&#10;AI/BI dashboard (5 pages)&#10;Genie space, Streamlit app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#1D425C;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="src" target="land"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="land" target="gold"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="gold" target="use"><mxGeometry relative="1" as="geometry" /></mxCell>
