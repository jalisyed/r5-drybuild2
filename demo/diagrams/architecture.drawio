      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="src" value="Sources (assumed)&#10;POS daily export&#10;Weekly inventory&#10;Loyalty file&#10;Promotions calendar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEFF2;strokeColor=#1D425C;" vertex="1" parent="1">
