{
  "datasets": [
    {
      "name": "ds_exec",
      "displayName": "Daily store/category sales",
      "queryLines": [
        "SELECT event_date, region, category, channel, net_sales, margin, discount_amt, units, transactions ",
        "FROM gold_daily_store_category"
      ],
      "columns": [
        {"displayName": "Net Sales", "description": "Total net sales", "expression": "SUM(`net_sales`)"},
        {"displayName": "Net Margin", "description": "Total net margin (fixed definition)", "expression": "SUM(`margin`)"},
        {"displayName": "Margin Rate", "description": "Net margin divided by sales after returns (fixed definition)", "expression": "SUM(`margin`) / SUM(`net_sales`)"},
        {"displayName": "Total Transactions", "description": "Total transactions", "expression": "SUM(`transactions`)"}
      ]
    },
    {
      "name": "ds_leakage",
      "displayName": "Margin leakage (returns and discounts)",
      "queryLines": [
        "SELECT month, category, gross_net_sales, returns_value, discount_given, net_margin ",
        "FROM gold_margin_leakage"
      ],
      "columns": [
        {"displayName": "Return Rate", "description": "Returns value over gross net sales", "expression": "SUM(`returns_value`) / SUM(`gross_net_sales`)"},
        {"displayName": "Discount Rate", "description": "Discount given over gross net sales plus discount", "expression": "SUM(`discount_given`) / (SUM(`gross_net_sales`) + SUM(`discount_given`))"}
      ]
    },
    {
      "name": "ds_promo",
      "displayName": "Promotion effectiveness",
      "queryLines": [
        "SELECT promo_id, promo_name, category, start_date, discount_pct, promo_days, lift, margin_change_per_day, verdict ",
        "FROM gold_promo_effectiveness"
      ]
    },
    {
      "name": "ds_stockout",
      "displayName": "Stock-out exposure",
      "queryLines": [
        "SELECT store_id, sku, category, week_start, stockout_days, est_lost_units, est_lost_margin ",
        "FROM gold_stockout_exposure"
      ]
    },
    {
      "name": "ds_hourly",
      "displayName": "Sales by weekday and hour",
      "queryLines": [
        "SELECT date_format(event_date,'E') AS dow_name, dayofweek(event_date) AS dow, hour(event_ts) AS hr, ",
        "       count(DISTINCT txn_id) AS transactions, sum(net_sales) AS net_sales ",
        "FROM silver_sales_lines ",
        "GROUP BY dow_name, dow, hr"
      ]
    },
    {
      "name": "ds_loyalty",
      "displayName": "Loyalty cohort retention",
      "queryLines": [
        "WITH cohort_share AS ( ",
        "  SELECT g.cohort_month, g.months_since, g.active_customers / c0.n0 AS share ",
        "  FROM gold_loyalty_cohorts g ",
        "  JOIN (SELECT cohort_month, active_customers AS n0 FROM gold_loyalty_cohorts WHERE months_since = 0) c0 ",
        "    ON g.cohort_month = c0.cohort_month ",
        ") ",
        "SELECT months_since, avg(share) AS share_still_buying ",
        "FROM cohort_share ",
        "GROUP BY months_since"
      ]
    },
    {
      "name": "ds_basket",
      "displayName": "Basket affinity (top pairs)",
      "queryLines": [
        "SELECT sku_a, sku_b, together, lift ",
        "FROM gold_basket_affinity ",
        "ORDER BY lift DESC LIMIT 10"
      ]
    },
    {
      "name": "ds_trust",
      "displayName": "Data trust",
      "queryLines": [
        "SELECT bronze_rows, silver_rows, quarantined_rows, duplicates_removed_est, ",
        "       median_latency_min, p95_latency_min, late_share, latest_event_ts ",
        "FROM gold_data_trust"
      ]
    },
    {
      "name": "ds_quarantine",
      "displayName": "Quarantined rows by reason",
      "queryLines": [
        "SELECT reason, count(*) AS rows_count, count(DISTINCT store_id) AS stores_affected ",
        "FROM silver_quarantine ",
        "GROUP BY reason"
      ]
    },
    {
      "name": "ds_margin_at_risk",
      "displayName": "Margin at risk before the next peak (ESTIMATE)",
      "queryLines": [
        "SELECT ",
        "  (SELECT sum(CASE WHEN verdict='margin dilutive' THEN margin_change_per_day*promo_days ELSE 0 END) FROM gold_promo_effectiveness) AS promo_margin_below_baseline, ",
        "  (SELECT sum(est_lost_margin) FROM gold_stockout_exposure) AS stockout_est_margin, ",
        "  (SELECT abs(sum(CASE WHEN verdict='margin dilutive' THEN margin_change_per_day*promo_days ELSE 0 END)) FROM gold_promo_effectiveness) ",
        "    + (SELECT sum(est_lost_margin) FROM gold_stockout_exposure) AS total_margin_at_risk"
      ]
    },
    {
      "name": "ds_other_denominator",
      "displayName": "Margin rate, other denominator (same dollars, different denominator)",
      "queryLines": [
        "SELECT sum(net_margin) / sum(gross_net_sales) AS margin_rate_other_denominator ",
        "FROM gold_margin_leakage"
      ]
    },
    {
      "name": "ds_loyalty_milestones",
      "displayName": "Loyalty retention milestones",
      "queryLines": [
        "WITH cohort_share AS ( ",
        "  SELECT g.cohort_month, g.months_since, g.active_customers / c0.n0 AS share ",
        "  FROM gold_loyalty_cohorts g ",
        "  JOIN (SELECT cohort_month, active_customers AS n0 FROM gold_loyalty_cohorts WHERE months_since = 0) c0 ",
        "    ON g.cohort_month = c0.cohort_month ",
        ") ",
        "SELECT months_since, avg(share) AS share_still_buying ",
        "FROM cohort_share ",
        "WHERE months_since IN (1,3,6,12) ",
        "GROUP BY months_since"
      ]
    }
  ],
  "pages": [
